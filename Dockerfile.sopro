FROM python:3.11-slim-bookworm

ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
ARG TORCH_VERSION=2.11.0
ARG TORCHAUDIO_VERSION=2.11.0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        libgomp1 \
        libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel
RUN python -m pip install --no-cache-dir --index-url "${PYTORCH_INDEX_URL}" \
    "torch==${TORCH_VERSION}" \
    "torchaudio==${TORCHAUDIO_VERSION}"

COPY requirements-sopro.txt /app/requirements-sopro.txt
RUN python -m pip install --no-cache-dir -r /app/requirements-sopro.txt

COPY xtts_service /app/xtts_service
COPY sopro_service /app/sopro_service

ENTRYPOINT ["python", "-m", "sopro_service.cli"]
CMD ["--interactive"]
